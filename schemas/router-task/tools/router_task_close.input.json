{
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$"
    },
    "expectedControlVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedOwner": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "executionId": {
              "type": "string"
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "executionId",
            "generation"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "taskId",
    "idempotencyKey",
    "expectedControlVersion",
    "expectedOwner",
    "reason"
  ],
  "additionalProperties": false
}
